{
  "name": "defense-against-distractions",
  "version": "1.6.1",
  "private": true,
  "type": "module",
  "scripts": {
    "cws:status": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/chrome-web-store-api.ps1 -Action status",
    "cws:upload": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/chrome-web-store-api.ps1 -Action upload",
    "cws:publish": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/chrome-web-store-api.ps1 -Action publish",
    "package": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/package-extension.ps1",
    "verify:release": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/verify-release.ps1",
    "verify:manifest": "node scripts/check-manifest-references.mjs",
    "verify:imports": "node scripts/check-relative-imports.mjs",
    "verify:locales": "node scripts/check-locale-coverage.mjs",
    "verify:package": "node scripts/check-package-output.mjs",
    "audit:folder-density": "node scripts/audit-folder-density.mjs",
    "audit:folder-density:strict": "node scripts/audit-folder-density.mjs --fail",
    "audit:file-sizes": "node scripts/audit-file-sizes.mjs",
    "audit:file-sizes:strict": "node scripts/audit-file-sizes.mjs --fail",
    "test": "node --test \"test/**/*.test.js\""
  }
}
